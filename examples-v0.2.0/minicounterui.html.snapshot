{"contexts":{"server api":{"name":"server api","message":" Given the following source code: // Technical summary: This implementation sets up an API server with CORS support, exposing endpoints to get and increment a count.\n\nconst http = require('http');\nconst url = require('url');\n\nlet count = 0;\n\nconst requestListener = (req, res) => {\n    res.setHeader('Access-Control-Allow-Origin', '*');\n    res.setHeader('Access-Control-Allow-Methods', 'GET, POST');\n    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');\n\n    const parsedUrl = url.parse(req.url, true);\n\n    if (parsedUrl.pathname === '/count') {\n        if (req.method === 'GET') {\n            res.writeHead(200, { 'Content-Type': 'application/json' });\n            res.end(JSON.stringify({ count }));\n        } else if (req.method === 'POST') {\n            count += 1;\n            res.writeHead(200, { 'Content-Type': 'application/json' });\n            res.end(JSON.stringify({ count }));\n        } else {\n            res.writeHead(405);\n            res.end();\n        }\n    } else {\n        res.writeHead(404);\n        res.end();\n    }\n};\n\nconst server = http.createServer(requestListener);\n\nserver.listen(3001, () => {\n    console.log('API Server listening on port 3001');\n});\n\n// LLMED-COMPILED\n\n\n\n"},"UI":{"name":"UI","message":"    Use tailwind.\n    Base of server api is 'http://localhost:3001'.\n\n    Show the latest counter using the endpoint '/count'.\n    Has a button that calls '/count'..\n"}}}