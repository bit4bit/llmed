<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <title>Counter</title>
</head>
<body class="flex items-center justify-center h-screen bg-gray-100">
    <div class="text-center">
        <h1 class="text-2xl font-bold mb-4">Counter: <span id="count">0</span></h1>
        <button id="incrementButton" class="px-4 py-2 bg-blue-500 text-white rounded">Increment</button>
    </div>

    <script>
        const countDisplay = document.getElementById('count');
        const incrementButton = document.getElementById('incrementButton');

        const updateCount = async () => {
            const response = await fetch('http://localhost:3010/count');
            const data = await response.json();
            countDisplay.textContent = data.count;
        };

        incrementButton.addEventListener('click', async () => {
            await fetch('http://localhost:3010/count', { method: 'POST' });
            updateCount();
        });

        // Initial count fetch
        updateCount();
    </script>
</body>
</html>
