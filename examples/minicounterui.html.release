<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <title>Counter UI</title>
</head>
<body class="flex flex-col items-center justify-center min-h-screen bg-gray-100">
    <h1 class="text-4xl font-bold mb-4">Counter</h1>
    <div id="counter" class="text-2xl mb-4">Count: 0</div>
    <button id="fetch-button" class="px-4 py-2 bg-blue-500 text-white rounded">Fetch Count</button>

    <script>
        const fetchCount = async () => {
            const response = await fetch('http://localhost:3011/count');
            if (response.ok) {
                const data = await response.json();
                document.getElementById('counter').innerText = `Count: ${data.count}`;
            } else {
                console.error('Failed to fetch count');
            }
        };

        document.getElementById('fetch-button').addEventListener('click', fetchCount);
    </script>
</body>
</html>
