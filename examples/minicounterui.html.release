<!--<llmed-code context='UI' digest='9934ae753d335cb5f77799da5e778e0ea33839e6d50a38b0601764c912a2c45f' after=''>-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Counter App</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex items-center justify-center h-screen bg-gray-100">
    <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">Counter</h1>
        <div id="counter" class="text-2xl mb-4">Loading...</div>
        <button id="fetch" class="bg-green-500 text-white px-4 py-2 rounded">Fetch Counter</button>
        <button id="increase" class="bg-blue-500 text-white px-4 py-2 rounded">Increase Counter</button>
    </div>

    <script>
        const apiBase = 'http://localhost:3007';

        async function fetchCounter() {
            const response = await fetch(`${apiBase}/count`);
            const data = await response.json();
            document.getElementById('counter').innerText = data.count;
        }

        document.getElementById('fetch').addEventListener('click', fetchCounter);

        document.getElementById('increase').addEventListener('click', async () => {
            await fetch(`${apiBase}/count`, { method: 'POST' });
            fetchCounter();
        });

        fetchCounter();
    </script>
    <!-- LLMED-COMPILED -->
</body>
</html>
