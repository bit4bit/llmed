#<llmed-code context='dependencies' digest='aee43ad4fd3355a24444718d6ad8ea1f763b1fd78cd1768c7833bd55d4ea0395' after='718c0d74d0d775ce3a25eff47b10192243c34d023608ef5ad381d7a30d9285b5'>
import pygame
#</llmed-code>
#<llmed-code context='Entities' digest='718c0d74d0d775ce3a25eff47b10192243c34d023608ef5ad381d7a30d9285b5' after='f6bceacd7cd440d0a4311731e2c47d2b1d5c52e76f61ffe9539cd46f2d1fbe49'>
class Grid:
    def __init__(self, width, height):
        self.width = width
        self.height = height
        self.cells = [[None for _ in range(width)] for _ in range(height)]

class Shape:
    SHAPES = {
        'L': [(0, 0), (1, 0), (2, 0), (2, 1)],
        'E': [(0, 0), (1, 0), (2, 0), (0, 1)],
        'T': [(0, 0), (1, 0), (2, 0), (1, 1)]
    }

    def __init__(self, kind, color):
        self.kind = kind
        self.color = color
        self.position = [0, 0]
        self.pieces = [Piece(self, x, y) for x, y in self.SHAPES[kind]]

class Piece:
    def __init__(self, shape, x, y):
        self.shape = shape
        self.x = x
        self.y = y

class Player:
    def __init__(self, shape):
        self.shape = shape

    def move_left(self):
        self.shape.position[0] -= 1

    def move_right(self):
        self.shape.position[0] += 1
#</llmed-code>
#<llmed-code context='Logic' digest='f6bceacd7cd440d0a4311731e2c47d2b1d5c52e76f61ffe9539cd46f2d1fbe49' after='371c93dae000c12717c7c79703baf29f3a9f46bfc058e9f0f7c35ec229810512'>
import random

class Game:
    def __init__(self, grid, player):
        self.grid = grid
        self.player = player
        self.game_over = False
        self.shapes = list(Shape.SHAPES.keys())
        self.colors = [(random.randint(0, 255), random.randint(0, 255), random.randint(0, 255)) for _ in range(len(self.shapes))]

    def start(self):
        self.generate_shape()

    def generate_shape(self):
        kind = random.choice(self.shapes)
        color = self.colors[self.shapes.index(kind)]
        new_shape = Shape(kind, color)
        new_shape.position[0] = random.randint(0, self.grid.width - len(new_shape.pieces))
        self.player.shape = new_shape

    def update(self):
        if not self.game_over:
            self.move_shape_down()

    def move_shape_down(self):
        self.player.shape.position[1] += 1
        if self.check_collision():
            self.player.shape.position[1] -= 1
            self.place_shape()
            self.generate_shape()

    def check_collision(self):
        for piece in self.player.shape.pieces:
            x, y = piece.shape.position[0] + piece.x, piece.shape.position[1] + piece.y
            if y >= self.grid.height or self.grid.cells[y][x] is not None:
                return True
        return False

    def place_shape(self):
        for piece in self.player.shape.pieces:
            x, y = piece.shape.position[0] + piece.x, piece.shape.position[1] + piece.y
            self.grid.cells[y][x] = piece
#</llmed-code>
#<llmed-code context='Main' digest='371c93dae000c12717c7c79703baf29f3a9f46bfc058e9f0f7c35ec229810512' after='LLMED-COMPILED'>
def main():
    pygame.init()
    screen = pygame.display.set_mode((300, 600))
    clock = pygame.time.Clock()

    grid = Grid(10, 20)
    player = Player(None)
    game = Game(grid, player)
    game.start()

    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_LEFT:
                    game.player.move_left()
                if event.key == pygame.K_RIGHT:
                    game.player.move_right()

        game.update()

        screen.fill((0, 0, 0))
        for y in range(grid.height):
            for x in range(grid.width):
                pygame.draw.rect(screen, (255, 255, 255), (x * 30, y * 30, 30, 30), 1)

        if game.player.shape:
            for piece in game.player.shape.pieces:
                x = (game.player.shape.position[0] + piece.x) * 30
                y = (game.player.shape.position[1] + piece.y) * 30
                pygame.draw.rect(screen, game.player.shape.color, (x, y, 30, 30))

        for y in range(grid.height):
            for x in range(grid.width):
                if grid.cells[y][x] is not None:
                    pygame.draw.rect(screen, grid.cells[y][x].shape.color, (x * 30, y * 30, 30, 30))

        pygame.display.flip()
        clock.tick(5)

    pygame.quit()

if __name__ == "__main__":
    main()
#</llmed-code>