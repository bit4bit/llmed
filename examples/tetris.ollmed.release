#<llmed-code context='dependencies' digest='aee43ad4fd3355a24444718d6ad8ea1f763b1fd78cd1768c7833bd55d4ea0395' after='73cf5ab557762af929fbe6285dfec04d998888239cda5f17f48a2ea1365a2515'>
import pygame
import random
#</llmed-code>

#<llmed-code context='Entities' digest='73cf5ab557762af929fbe6285dfec04d998888239cda5f17f48a2ea1365a2515' after='89c9f4964ce765ca5c657dc66e31b91a25843c659106bd3274e446514bb37b2e'>
class Grid:
    def __init__(self, width, height):
        self.width = width
        self.height = height
        self.cells = [[None for _ in range(width)] for _ in range(height)]

class Shape:
    SHAPES = {
        'L': [[1, 0], [1, 0], [1, 1]],
        'E': [[1, 1], [1, 1]],
        'T': [[0, 1, 0], [1, 1, 1]],
        '|': [[1], [1], [1], [1]]
    }

    def __init__(self, kind, color):
        self.kind = kind
        self.color = color
        self.shape = self.SHAPES[kind]
        self.rotation = 0

    def rotate(self):
        self.rotation = (self.rotation + 1) % 4
        self.shape = [list(row) for row in zip(*self.shape[::-1])]

class Piece:
    def __init__(self, x, y, shape):
        self.x = x
        self.y = y
        self.shape = shape

class Player:
    def __init__(self):
        self.removed_rows = 0

    def increase_points(self, rows):
        self.removed_rows += rows
#</llmed-code>

#<llmed-code context='Logic' digest='89c9f4964ce765ca5c657dc66e31b91a25843c659106bd3274e446514bb37b2e' after='9e9089145836632f04dd80db3cc8b3255026e15d130ba50442f88a24d4f9269a'>
class Tetris:
    SHAPES = ['L', 'E', 'T', '|']
    COLORS = [(255, 0, 0), (0, 255, 0), (0, 0, 255), (255, 255, 0)]

    def __init__(self, grid_width, grid_height):
        self.grid = Grid(grid_width, grid_height)
        self.player = Player()
        self.current_shape = self.get_new_shape()
        self.game_over = False

    def get_new_shape(self):
        shape_kind = random.choice(self.SHAPES)
        color = random.choice(self.COLORS)
        return Piece(random.randint(0, self.grid.width - len(Shape.SHAPES[shape_kind][0])), 0, Shape(shape_kind, color))

    def move_shape(self, dx, dy):
        self.current_shape.x += dx
        self.current_shape.y += dy

    def rotate_shape(self):
        prev_rotation = self.current_shape.shape.rotation
        self.current_shape.shape.rotate()
        if not self.is_valid_position():
            self.current_shape.shape.rotation = prev_rotation
            self.current_shape.shape.shape = [list(row) for row in zip(*self.current_shape.shape.shape[::-1])]

    def is_valid_position(self):
        for y, row in enumerate(self.current_shape.shape.shape):
            for x, cell in enumerate(row):
                if cell and (self.current_shape.x + x < 0 or self.current_shape.x + x >= self.grid.width or
                            self.current_shape.y + y >= self.grid.height or
                            self.grid.cells[self.current_shape.y + y][self.current_shape.x + x]):
                    return False
        return True

    def fix_shape(self):
        for y, row in enumerate(self.current_shape.shape.shape):
            for x, cell in enumerate(row):
                if cell:
                    self.grid.cells[self.current_shape.y + y][self.current_shape.x + x] = self.current_shape.shape.color
        self.remove_full_rows()
        self.current_shape = self.get_new_shape()
        if not self.is_valid_position():
            self.game_over = True

    def remove_full_rows(self):
        lines_cleared = 0
        for y, row in enumerate(self.grid.cells):
            if all(row):
                del self.grid.cells[y]
                self.grid.cells.insert(0, [None for _ in range(self.grid.width)])
                lines_cleared += 1
        self.player.increase_points(lines_cleared)

    def update(self):
        self.move_shape(0, 1)
        if not self.is_valid_position():
            self.move_shape(0, -1)
            self.fix_shape()
#</llmed-code>

#<llmed-code context='Main' digest='9e9089145836632f04dd80db3cc8b3255026e15d130ba50442f88a24d4f9269a' after='LLMED-COMPILED'>
def main():
    pygame.init()
    screen_width, screen_height = 300, 600
    grid_width, grid_height = 10, 20
    screen = pygame.display.set_mode((screen_width, screen_height))
    pygame.display.set_caption("Tetris")
    clock = pygame.time.Clock()
    tetris = Tetris(grid_width, grid_height)
    fall_time = 0
    fall_speed = 500  # milliseconds

    font = pygame.font.Font(None, 36)

    print("Instructions:")
    print("Use left and right arrow keys to move the shape.")
    print("Use down arrow key to accelerate the shape.")
    print("Use space key to rotate the shape 90 degrees clockwise.")

    while not tetris.game_over:
        screen.fill((0, 0, 0))
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                tetris.game_over = True
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_LEFT:
                    tetris.move_shape(-1, 0)
                    if not tetris.is_valid_position():
                        tetris.move_shape(1, 0)
                elif event.key == pygame.K_RIGHT:
                    tetris.move_shape(1, 0)
                    if not tetris.is_valid_position():
                        tetris.move_shape(-1, 0)
                elif event.key == pygame.K_DOWN:
                    tetris.move_shape(0, 1)
                    if not tetris.is_valid_position():
                        tetris.move_shape(0, -1)
                elif event.key == pygame.K_SPACE:
                    tetris.rotate_shape()

        fall_time += clock.get_rawtime()
        clock.tick()

        if fall_time > fall_speed:
            fall_time = 0
            tetris.update()

        draw_grid(screen, tetris.grid)
        draw_shape(screen, tetris.current_shape)
        draw_player_info(screen, tetris.player)

        pygame.display.flip()

    pygame.quit()

def draw_grid(screen, grid):
    cell_size = 30
    for y, row in enumerate(grid.cells):
        for x, cell in enumerate(row):
            if cell:
                pygame.draw.rect(screen, cell, (x * cell_size, y * cell_size, cell_size, cell_size))
            pygame.draw.rect(screen, (255, 255, 255), (x * cell_size, y * cell_size, cell_size, cell_size), 1)

def draw_shape(screen, shape):
    cell_size = 30
    for y, row in enumerate(shape.shape.shape):
        for x, cell in enumerate(row):
            if cell:
                pygame.draw.rect(screen, shape.shape.color, ((shape.x + x) * cell_size, (shape.y + y) * cell_size, cell_size, cell_size))
                pygame.draw.rect(screen, (255, 255, 255), ((shape.x + x) * cell_size, (shape.y + y) * cell_size, cell_size, cell_size), 1)

def draw_player_info(screen, player):
    font = pygame.font.Font(None, 36)
    text = font.render(f"Points: {player.removed_rows}", True, (255, 255, 255))
    screen.blit(text, (10, 10))

if __name__ == "__main__":
    main()
#</llmed-code>