set_llm provider: :like_openai, api_key: ENV['TOGETHERAI_API_KEY'], model: 'Qwen/Qwen2.5-Coder-32B-Instruct', options: {uri_base: 'https://api.together.xyz/v1'}

application "TETRIS", release: 12, language: :python, output_file: "tetris.ollmed" do
  context "dependencies" do
    <<-LLM
    * Use pygame.
    LLM
  end

  context "Entities" do
    <<-LLM
    Grid:
    - has a width and height.
    - every cell can contain part of a Piece or be empty.

    Shape:
    - Contains multiples piece.
    - kind of shapes:
      - L
      - E
      - T
      - |
      - --
    - Can rotate.
    Piece:
    - belongs to a Shape.

    Player:
    - Can control the horizontal move of a shape.
    - has the amount of removed rows.
    LLM
  end

  context "Logic" do
    <<-LLM
    Multiple shapes are stored.
    When the game starts, a grid is automatically generated.
    When the game starts, the first random shape is automatically generated at a random horizontal position at the top of the grid.
    On every iteration of the game, the shape moves from the top to the bottom of the screen. Once a piece touches the bottom or another piece, the shape stops moving and is stored as part of the stack. Then, a new shape is automatically generated at the top of the grid.
    When all the pieces in the same row are connected, then remove all the connected pieces and increase the player counter of removed rows.
    LLM
  end

  context "Main" do
    <<-LLM
    Draw a grid with a black background and white borders.
    Draw all the shapes.
    Draw the player counter of removed rows (named as Points) in white at the top of the window.
    Each shape has unique random color.
    Player using the keyboard can move the current shape from left to right.
    Player using the keyboard (key down) can accelerate the current shape.
    Player using the keyboard (key space) can rotate the shape 90 degress clockwise.

    Show in the console the instructions how to play.
    LLM
  end
end
