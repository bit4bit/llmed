{"contexts":{"server api":{"name":"server api","message":" Given the following source code: //<llmed-code context='dependencies' digest='d1c3c63de4da6a330a1a3975e280f1a69515e1bf34bbb8b11db37e40ac5bebd4' after='49b42b4a086e3fbd6843ce2df01ca9bae5933a048086c9ea2d48d3354abc2bfd'>\n// No external dependencies are used\n//</llmed-code>\n\n//<llmed-code context='API' digest='49b42b4a086e3fbd6843ce2df01ca9bae5933a048086c9ea2d48d3354abc2bfd' after=''>\nconst http = require('http');\n\nlet count = 0;\n\nconst requestListener = (req, res) => {\n    res.setHeader('Access-Control-Allow-Origin', '*');\n    res.setHeader('Access-Control-Allow-Methods', 'GET, POST');\n    res.setHeader('Content-Type', 'application/json');\n\n    if (req.method === 'GET' && req.url === '/count') {\n        res.writeHead(200);\n        res.end(JSON.stringify({ count }));\n    } else if (req.method === 'POST' && req.url === '/count') {\n        count += 1;\n        res.writeHead(200);\n        res.end(JSON.stringify({ count }));\n    } else {\n        res.writeHead(404);\n        res.end(JSON.stringify({ message: 'Not Found' }));\n    }\n};\n\nconst server = http.createServer(requestListener);\n\nserver.listen(3007, () => {\n    console.log('API Server listening on port 3007');\n});\n//</llmed-code>\n\n\n\n"},"UI":{"name":"UI","message":"    Use tailwind.\n    Base of server api is 'http://localhost:3007'.\n\n    Show the latest counter using the endpoint '/count'.\n    Has a button to fetch the counter.\n    Has a button that increase the counter.\n"}}}