class Juego
  attr_accessor :puntos

  def initialize
    @puntos = 0
  end

  def finalizar_juego
    puts "¡Juego finalizado! Has alcanzado la salida."
  end

  def almacenar_historial
    File.open(File.expand_path('~') + '/consola-laberinto.history', 'a') do |file|
      file.puts @puntos
    end
  end
end
