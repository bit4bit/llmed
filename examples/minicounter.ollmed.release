//<llmed-code context='API' digest='49b42b4a086e3fbd6843ce2df01ca9bae5933a048086c9ea2d48d3354abc2bfd' after=''>
const http = require('http');

let count = 0;

const requestListener = (req, res) => {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST');
    res.setHeader('Content-Type', 'application/json');

    if (req.method === 'GET' && req.url === '/count') {
        res.writeHead(200);
        res.end(JSON.stringify({ count }));
    } else if (req.method === 'POST' && req.url === '/count') {
        count += 1;
        res.writeHead(200);
        res.end(JSON.stringify({ count }));
    } else {
        res.writeHead(404);
        res.end(JSON.stringify({ message: 'Not Found' }));
    }
};

const server = http.createServer(requestListener);

server.listen(3007, () => {
    console.log('API Server listening on port 3007');
});
//</llmed-code>
