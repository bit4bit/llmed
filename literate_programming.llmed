set_llm provider: :openai, api_key: ENV['OPENAI_API_KEY'], model: 'gpt-4o-mini'

application "Literate Programming Markdown", release: 1, language: :ruby, output_file: "markdown.rb", output_dir: "./lib/llmed/literate_programming/", release_dir: "./lib/llmed/literate_programming/" do
  context "Library LLMed::LiterateProgramming::Markdown" do
    <<-LLM
    class LLMed::LiterateProgramming::Markdown
      def parse(input)
        Here implementation using the rspec tests as example:
        #{File.read('spec/literate_programming_spec.rb')}
      end
    end
    LLM
  end
end
